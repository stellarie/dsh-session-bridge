{
  "name": "@stellarie/dsh-session-bridge",
  "version": "0.1.0",
  "description": "Drive DeepSeek Harness sessions from an MCP client through a token-guarded loopback bridge",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "session",
    "bridge"
  ],
  "homepage": "https://github.com/stellarie/dsh-session-bridge#readme",
  "bugs": {
    "url": "https://github.com/stellarie/dsh-session-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stellarie/dsh-session-bridge.git"
  },
  "author": "stellarie",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-session-bridge-mcp": "lib/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "README*.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "prepare": "tsc -b && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
